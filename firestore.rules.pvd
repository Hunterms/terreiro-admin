// ============================================================================
// FIRESTORE SECURITY RULES — Projeto: terreiro-pvd
// ============================================================================
// Como deployar:
//   Firebase Console → Projeto terreiro-pvd → Firestore Database → Rules
//   Cole o conteúdo abaixo e publique.
//
// Modelo de segurança:
// - Admin (auth): tudo aberto
// - Público (sem auth): só pub_slots_ocupados pra ver/marcar slots ocupados
//   e adm_solicitacoes para criar pedidos (sem ler), adm_config/agendamento +
//   adm_servicos pra config do agendar.html, e fin_filhos + collections do
//   area-filho.html (trust-based via telefone)
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── PAPÉIS ────────────────────────────────────────────────────────────
    // Antes desta seção, a regra era `allow read, write: if request.auth != null`
    // pra tudo: qualquer conta autenticada escrevia qualquer coisa. Com 2 contas
    // dava pra viver; no dia em que um filho ganhasse login, ele alcançaria a
    // contabilidade inteira.
    //
    // Papéis são custom claims, gravadas pela rota /papel do Worker (não dá pelo
    // console). A LISTA DE EMAIL abaixo é rede de segurança, não desleixo: claim
    // só entra no token depois de renovar a sessão, e sem a rede publicar estas
    // rules trancaria admin, financeiro e PDV de uma vez. Some quando as claims
    // estiverem confirmadas nas duas contas.
    function ehAuth()  { return request.auth != null; }
    function email()   { return request.auth.token.email; }
    function claim(p)  { return request.auth.token[p] == true; }

    function ehAdmin() {
      return ehAuth() && (claim('admin') ||
        email() in ['hunter.soares.c@gmail.com', 'nandomacedo42@gmail.com']);
    }
    function ehFinanceiro() { return ehAdmin() || (ehAuth() && claim('financeiro')); }
    function ehLoja()       { return ehAdmin() || (ehAuth() && claim('loja')); }

    // ── LEITURA AUTENTICADA AMPLA, ESCRITA POR DONO ───────────────────────
    // O risco é escrita. Leitura entre apps é o que faz o sistema funcionar
    // (o admin cruza dado do financeiro, o financeiro lê filhos, etc).
    match /{document=**} {
      allow read: if ehAuth();
      allow write: if ehAdmin();
    }

    // Dinheiro da casa: o financeiro é o dono
    match /fin_gastos/{id}           { allow write: if ehFinanceiro(); }
    match /fin_gastos_var/{id}       { allow write: if ehFinanceiro(); }
    match /fin_gastos_avulso/{id}    { allow write: if ehFinanceiro(); }
    match /fin_dividas/{id}          { allow write: if ehFinanceiro(); }
    match /fin_doacoes/{id}          { allow write: if ehFinanceiro(); }
    match /fin_sonhos/{id}           { allow write: if ehFinanceiro(); }
    match /fin_eventos/{id}          { allow write: if ehFinanceiro(); }
    match /fin_cursos/{id}           { allow write: if ehFinanceiro(); }
    match /fin_curso_alunos/{id}     { allow write: if ehFinanceiro(); }
    match /fin_curso_pagamentos/{id} { allow write: if ehFinanceiro(); }
    match /fin_pagamentos/{id}       { allow write: if ehFinanceiro(); }
    match /fin_estoque/{id}          { allow write: if ehFinanceiro(); }

    // Loja física: o PDV é o dono. A conta do tablet NÃO alcança contabilidade.
    match /products/{id}      { allow write: if ehLoja(); }
    match /sales/{id}         { allow write: if ehLoja(); }
    match /eventos_caixa/{id} { allow write: if ehLoja(); }
    match /pdv_repasses/{id}  { allow write: if ehLoja(); }

    // ── O FINANCEIRO ENCOSTA EM TRÊS COISAS QUE NÃO SÃO DELE ──────────────
    // Depois das mudanças de 30/07, o app do financeiro escreve em collections
    // cujo dono é o admin. Hoje funciona porque as duas contas existentes são
    // admin — mas uma conta com papel só `financeiro` ficaria quebrada, e sem
    // estas regras a tabela de donos seria mentira.
    //
    // A permissão é por CAMPO, não por collection: cada uma libera exatamente
    // o que a tela daquele app edita, e nada além. Se alguém mandar um campo a
    // mais no mesmo update, o Firestore recusa o update inteiro.

    // mensalidade do filho — a pessoa continua sendo do admin
    match /fin_filhos/{id} {
      allow update: if ehFinanceiro() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['valor', 'prazo', 'prazoObs']);
    }

    // planejamento de compra — a despensa continua sendo do admin
    match /adm_despensa/{id} {
      allow update: if ehFinanceiro() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['consumo', 'custo']);
    }

    // "avisou do atraso" tira o acréscimo — decisão de cobrança, do financeiro.
    // O resto do doc é do Worker, que escreve por service account.
    match /fin_mensalidade_pedidos/{id} {
      allow update: if ehFinanceiro() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avisou_atraso']);
    }

    // ── Campos de pagamento: só o Worker escreve ──────────────────────────
    // O Worker usa a service account, que ignora estas rules. Então basta
    // barrar o público de já criar o doc com esses campos preenchidos.
    // Sem isso, alguém criava o pedido com checkout_centavos: 1, montava um
    // link de R$1 na mão (o /links da InfinitePay é aberto), pagava, e o
    // webhook aceitava. O Worker também recalcula o valor por cima disso —
    // são duas travas de propósito, porque é o caminho do dinheiro.
    function semCamposDePagamento() {
      return !request.resource.data.keys().hasAny([
        'checkout_centavos', 'checkout_order_nsu', 'checkout_url', 'checkout_criadoEm',
        'pago_automatico', 'pagoEm', 'pagamento_transaction_nsu', 'pagamento_slug',
        'pagamento_centavos', 'pagamento_parcelas', 'pagamento_recibo_url',
        'pagamento_suspeito', 'pagamento_suspeitoEm'
      ]);
    }

    // ── PÚBLICO: config + serviços (necessário pro agendar.html) ──────────
    match /adm_config/agendamento {
      allow read: if true;
    }
    match /adm_servicos/{id} {
      allow read: if true;
    }

    // ── PÚBLICO: pub_slots_ocupados (ESPELHO sem PII) ─────────────────────
    // Substitui leitura pública de adm_atendimentos/adm_solicitacoes.
    // Admin escreve atend_* via auth; agendar.html escreve sol_* via shape val.
    match /pub_slots_ocupados/{id} {
      allow read: if true;
      // Criação pública SÓ pra sol_<id> (vindo do agendar.html)
      allow create: if id.matches('sol_.*')
                    && request.resource.data.data is string
                    && request.resource.data.hora is string
                    && request.resource.data.dur is number
                    && request.resource.data.dur > 0
                    && request.resource.data.dur < 480
                    && request.resource.data.fonte == 'solicitacao';
      // update/delete só admin (admin sincroniza atend_*)
      allow update, delete: if request.auth != null;
    }

    // ── PÚBLICO: solicitacoes — só CREATE, sem READ ───────────────────────
    // Cliente público pode criar pedido, mas NÃO pode listar/ler outros.
    match /adm_solicitacoes/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.status == 'pendente'
                    && request.resource.data.origem == 'agendar_publico'
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 1
                    && request.resource.data.nome.size() < 200
                    && request.resource.data.tel is string
                    && request.resource.data.tel.size() > 0
                    && request.resource.data.tel.size() < 30
                    && request.resource.data.data is string
                    && request.resource.data.hora is string
                    && request.resource.data.valor_proposto is number
                    && request.resource.data.valor_proposto >= 0
                    && request.resource.data.valor_proposto < 100000
                    && semCamposDePagamento();
      allow update, delete: if request.auth != null;
    }

    // ── PÚBLICO: inscrições/pagamentos de evento ──────────────────────────
    // evento.html cria 1 doc por inscrição. Visitantes (form) e filhos (auto-
    // complete) entram aqui. Status muda pra 'pago' após admin confirmar.
    match /evento_inscricoes/{id} {
      allow read: if true;
      allow create: if request.resource.data.evento_id is string
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 1
                    && request.resource.data.nome.size() < 200
                    && request.resource.data.valor is number
                    && request.resource.data.valor >= 0
                    && request.resource.data.valor < 100000
                    && request.resource.data.status == 'aguardando'
                    && request.resource.data.origem == 'evento_publico'
                    && semCamposDePagamento();
      allow update, delete: if request.auth != null;
    }

    // ── atendimentos FECHADO publicamente ─────────────────────────────────
    // adm_atendimentos NÃO precisa de regra pública — coberto pela regra
    // genérica de auth no topo. Slots ocupados estão em pub_slots_ocupados.

    // ── PÚBLICO: dados pro area-filho.html ───────────────────────────
    // ⚠️ Expõe nome + tel dos filhos. Trust-based (auth via últimos 4 dígitos).
    match /fin_filhos/{id} {
      allow read: if true;
    }
    match /adm_funcoes/{id} {
      allow read: if true;
    }
    match /adm_escalas/{id} {
      allow read: if true;
      // Lojinha gerentes (Giovana/Aline) ajudam a definir a escala da função
      // Lojinha dentro de escalas tipo='gira' (mesmo modelo da aba escala do
      // admin). Trust-based — UI só expõe pra quem tem gerencia_lojinha=true,
      // e só altera as alocações da função Lojinha (preservando as outras).
      // Sem delete público — apagar uma escala inteira fica admin-only.
      allow create: if request.resource.data.tipo in ['gira','lojinha'];
      allow update: if resource.data.tipo in ['gira','lojinha']
                    && request.resource.data.tipo == resource.data.tipo;
    }
    match /adm_avisos/{id} {
      allow read: if true;
    }
    // Tarefas (kanban) — leitura pública pro area-filho.html mostrar
    // as tarefas do filho logado (trust-based, mesmo modelo das escalas)
    match /adm_kanban/{id} {
      allow read: if true;
    }

    // Disponibilidade: leitura + write público (trust-based)
    match /adm_disponibilidade/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.filho_id is string
                            && request.resource.data.filho_id.size() > 0;
    }


    // ── VENDAS EXTERNAS (vendas.html) ─────────────────────────────────────
    // Produtos: leitura pública (form precisa ler pra mostrar); escrita só admin
    match /vendas_produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Alunos de produto recorrente: só GET, nunca LIST.
    //
    // O modo "Já sou aluno" do vendas.html busca vendas_alunos/{produto}__{email}
    // pra não fazer o aluno antigo refazer o cadastro. Sem esta regra ele caía
    // em permission-denied e a busca só mostrava erro.
    //
    // `get` e `list` são permissões diferentes, e a diferença é o que segura
    // isto de pé: pra ler um doc é preciso JÁ SABER o email (ele está no id), e
    // a resposta é só o cadastro daquela pessoa. Sem `list`, ninguém consegue
    // varrer a collection e sair com a lista de emails e telefones dos alunos.
    match /vendas_alunos/{id} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Pedidos: criação pública (form), demais só admin
    match /vendas_pedidos/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.status == 'pendente'
                    && request.resource.data.origem == 'vendas_publico'
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 1
                    && request.resource.data.nome.size() < 200
                    && request.resource.data.tel is string
                    && request.resource.data.tel.size() > 0
                    && request.resource.data.tel.size() < 30
                    && request.resource.data.produto_id is string
                    && request.resource.data.valor is number
                    && request.resource.data.valor >= 0
                    && request.resource.data.valor < 1000000
                    && semCamposDePagamento();
      allow update, delete: if request.auth != null;
    }

    // Reembolsos: criação pública (form em /reembolso.html), demais só admin
    match /fin_reembolsos/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.status == 'pendente'
                    && request.resource.data.origem == 'reembolso_publico'
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 1
                    && request.resource.data.nome.size() < 200
                    && request.resource.data.tel is string
                    && request.resource.data.tel.size() > 0
                    && request.resource.data.tel.size() < 30
                    && request.resource.data.descricao is string
                    && request.resource.data.descricao.size() > 1
                    && request.resource.data.descricao.size() < 1000
                    && request.resource.data.valor is number
                    && request.resource.data.valor > 0
                    && request.resource.data.valor < 100000
                    && request.resource.data.data_compra is string
                    && request.resource.data.pix_chave is string
                    && request.resource.data.pix_chave.size() > 0
                    && request.resource.data.pix_chave.size() < 200;
      allow update, delete: if request.auth != null;
    }

    // ── MENSALIDADE: NADA público ─────────────────────────────────────────
    // Coberta pela regra de auth no topo — esta regra existe pra ser explícita
    // e pra travar o que a de cima já trava.
    //
    // O público NÃO pode criar nem escrever aqui, e isso não é detalhe: o valor
    // esperado da mensalidade é FIXADO no doc quando o link é gerado
    // (checkout_centavos), e a confirmação compara contra ele em vez de
    // recalcular — porque a multa depende da data. Se o público pudesse criar o
    // doc, plantaria um checkout_centavos de R$1, pagaria R$1 e o Worker
    // aceitaria. Ver MENSALIDADE.md seção 4.
    //
    // O filho paga pela area-filho.html, que chama o Worker; o Worker escreve
    // com service account e ignora estas rules. Ninguém precisa de acesso
    // público a esta collection.
    // Escrita é do admin e do Worker (que ignora rules). O financeiro tem uma
    // permissão POR CAMPO mais abaixo, só pro `avisou_atraso` — se aqui
    // estivesse `write: if request.auth != null`, aquela regra seria decorativa,
    // porque permissões de blocos diferentes se somam.
    match /fin_mensalidade_pedidos/{id} {
      allow read: if request.auth != null;
      allow write: if ehAdmin();
    }

    // ── PUSH: o id do doc é o próprio token ───────────────────────────────
    // `adm_push_tokens/{token}` — e é essa escolha que segura a regra de pé.
    //
    // O token do FCM é secreto e só o aparelho que o gerou conhece. Então
    // "pode escrever quem souber o id" não é o mesmo desleixo de sempre: pra
    // apagar ou trocar o registro de outra pessoa seria preciso já ter o token
    // dela, e quem tem o token dela já recebe as notificações dela de qualquer
    // jeito. Não há nada a ganhar.
    //
    // Isso é o que deixa o filho registrar sem login — ele entra na área dele
    // por 4 dígitos do telefone, não por Firebase Auth.
    //
    // O que continua fechado é o que importa: `list` só pra quem tem login (a
    // regra genérica lá em cima), então ninguém varre a collection pra sair com
    // a lista de aparelhos da casa. E `create` exige papel declarado e nada
    // além dos campos previstos — token não é lugar de guardar recado.
    match /adm_push_tokens/{token} {
      allow get: if ehAuth();
      // Token do FCM tem ~160 caracteres. O piso de 100 não é segurança — é o
      // que impede a collection de virar depósito de doc de id curto inventado
      // por quem nem tem um aparelho registrado.
      allow create, update: if token.size() > 100
                            && request.resource.data.papel in ['admin', 'filho']
                            && request.resource.data.keys().hasOnly(
                                 ['papel', 'filho_id', 'nome', 'uid', 'ua', 'criadoEm']);
      allow delete: if true;
    }

    // ── CONTAS FIXAS: vencimento e baixa do mês ───────────────────────────
    // `fin_gastos` é do financeiro (regra lá em cima). O que nasce aqui é a
    // baixa mensal, no mesmo formato do fin_pagamentos da mensalidade: um doc
    // por ciclo, booleano por conta. Os dois apps escrevem nele.
    match /fin_gastos_pagos/{ciclo} {
      allow read: if ehAuth();
      allow write: if ehFinanceiro();
    }

    // Rega diária: leitura + write público (QR-based / trust-based)
    // delete público pra liberar dia reservado (UX de "trocar com outra pessoa"
    // na area-filho.html). Auth client-side via 4 dígitos do tel do dono.
    match /adm_rega_diaria/{date} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(
        ['reserva', 'realizadoEm', 'filhos_marcaram', 'data']
      );
      allow delete: if true;
    }
  }
}

// ============================================================================
// PÓS-MIGRAÇÃO: rodar bootstrap de pub_slots_ocupados
// ============================================================================
// Como adm_atendimentos/adm_solicitacoes existentes ainda não têm espelho em
// pub_slots_ocupados, slots HOJE marcados estarão livres pro público até alguém
// editar/criar/aprovar de novo.
